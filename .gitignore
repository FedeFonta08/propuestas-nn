# Entorno y variables
.env
.env.*

# ============================================
# CARPETAS LOCALES — NO SUBIR A GITHUB
# ============================================
CRM_Contactos/
Campanas_Promociones/
Contratos_Polizas/
Estrategia_Analisis/
Formacion/
Marketing_Branding/
PTD_Transformacion/
Plantillas_Excel/
Presentaciones/
Productos_Guias/
Propuestas_Clientes/
Reclutamiento_CV/

# Carpeta de Herramientas - Solo subimos los HTML/Assets necesarios para GitHub Pages
Scripts_Herramientas/*
!Scripts_Herramientas/*.html
!Scripts_Herramientas/*.py
!Scripts_Herramientas/assets/
!Scripts_Herramientas/assets/**

# ============================================
# CREDENCIALES Y TOKENS — NUNCA SUBIR
# ============================================
credentials.json
token.json
token_drive.json
*.json
!package.json
!package-lock.json

# Python - Quitamos *.py para que TUS SCRIPTS sí se guarden como copia de seguridad
__pycache__/
*.pyc

# Bloqueo total de archivos de datos (aunque estén fuera de las carpetas)
*.xlsx
*.xls
*.csv
*.pdf
*.zip
*.rar

# IDE y OS
.vscode/
.idea/
.DS_Store
desktop.ini
config.js
